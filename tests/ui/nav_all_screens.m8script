# nav_all_screens.m8script — T4: reach every screen via `goto` (which itself
# verifies the header) and assert_no_overlap on each, catching layout
# regressions like the GROOVE-screen crash class (groovetest.m8script) across
# the whole UI, not just one screen. Complements nav.m8script (raw `key
# SHIFT+...` sequences) with the newer, more maintainable `goto` primitive.

goto SONG
assert_no_overlap

goto CHAIN
assert_no_overlap

goto PHRASE
assert_no_overlap

goto INSTRUMENT
assert_no_overlap

goto TABLE
assert_no_overlap

goto PROJECT
assert_no_overlap

goto GROOVE
assert_no_overlap

goto INST_MOD
assert_no_overlap

goto SCALE
assert_no_overlap

goto INST_POOL
assert_no_overlap

goto MIXER
# The exemption that used to live here is gone (MIXER_SPEC.md §5.1). The bars
# were rectangles drawn at sub-cell precision, so a fill boundary landing
# mid-cell marked that cell as written by both the background and foreground
# rect -- a limit of a cell-granularity check applied to sub-cell graphics, not
# a layout bug. Bars are font glyphs now: one character, one cell, one write.
assert_no_overlap

goto EFFECTS
assert_no_overlap

goto SONG
assert_no_overlap
