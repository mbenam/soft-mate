# Every assertion below is the baseline tempo plus or minus a step, so the whole
# file moves if the boot song's tempo changes -- which it did when the startup
# song became NEON DUSK at 112 BPM. Pin the baseline with an explicit load
# instead of tracking it, the same fix edit.m8script and playhead.m8script took
# after drifting on ambient boot state. sunrise.m8s is 128 BPM.
load songs/sunrise.m8s
wait 1

goto PROJECT
assert_screen contains "PROJECT"

# Check baseline whole tempo (sunrise.m8s is 128.00)
assert_field TEMPO 128.00 < >

# 1. Adjust whole tempo by 10s with X+UP and X+DOWN
key X+UP
assert_field TEMPO 138.00 < >

key X+UP
assert_field TEMPO 148.00 < >

key X+DOWN
assert_field TEMPO 138.00 < >

key X+DOWN
assert_field TEMPO 128.00 < >

# 2. Adjust whole tempo by 1 with X+RIGHT and X+LEFT
key X+RIGHT
assert_field TEMPO 129.00 < >

key X+LEFT
assert_field TEMPO 128.00 < >

# 3. Move to decimal portion (TEMPO_DEC)
key RIGHT
key X+UP
assert_field TEMPO 128.10 < >

key X+UP
assert_field TEMPO 128.20 < >

key X+DOWN
assert_field TEMPO 128.10 < >

key X+DOWN
assert_field TEMPO 128.00 < >

# 4. Move to tempo nudge (< >)
key RIGHT
# Key X+RIGHT nudges up, and returns on release
key X+RIGHT
assert_field TEMPO 128.00 < >

# Key X+LEFT nudges down, and returns on release
key X+LEFT
assert_field TEMPO 128.00 < >

assert_no_overlap
assert_no_error
