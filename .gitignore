build/
build_render/
build_asan/
*.obj
*.zip
artifacts/
scratch/
test_out_ui/
# Song bundles written by PROJECT > EXPORT/SHARE (src/io/BundleExport.cpp
# defaults its destination to "Bundles"). Output, not source — the songs and
# their samples are already tracked under songs/.
Bundles/

# Hardware-test artifacts (generated probes, oracles, captures, verdicts)
hwtest_out/
# Third-party reference manual (Dirtywave M8, copyrighted — kept local only)
manual/

# Generated audio/probe/render artifacts (regenerated by the tools; not source)
/render*.wav
/render*_events.csv
/probe*.m8s
/test_shape_*.wav
/test_shape_*_events.csv
/test_output.txt

# Scratch .m8s files the [io] tests write into the repo root. Each test removes
# its own file on the way out, but a REQUIRE that fails aborts the case before
# the cleanup runs -- so a red suite leaves them behind, and `git add -A` then
# sweeps them into a commit.
/T0_probe.m8s
/should_not_exist.m8s
/eq_identity.m8s
/*_rt.m8s
/mixer_tail.m8s
/spk_[ab].m8s
/temp_*.m8s

# Full upstream Mutable Instruments source (56MB nested git repo). Only the
# vendored subset in src/engine/braids/ is built; keep the full clone local.
third_party/eurorack/
__pycache__/
*.pyc
